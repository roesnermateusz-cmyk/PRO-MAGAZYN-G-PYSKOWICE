# ============================================================================
#  ResInvest ERP - konfiguracja srodowiska
#  Skopiuj ten plik jako .env i dostosuj wartosci.
# ============================================================================

# --- Srodowisko -------------------------------------------------------------
NODE_ENV=development
# Adres nasluchu. 0.0.0.0 udostepnia serwer w sieci lokalnej firmy.
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
# Ustaw na 1, jesli serwer pracuje za reverse proxy (nginx, IIS, Caddy).
TRUST_PROXY=0

# --- Dane aplikacji ---------------------------------------------------------
# Katalog bazy danych, zalacznikow i kopii zapasowych.
# Windows (instalacja serwisowa): C:\ProgramData\ResInvestERP
DATA_DIR=./server/data
# DATABASE_FILE=./server/data/resinvest.sqlite
# ATTACHMENTS_DIR=./server/data/attachments
# BACKUP_DIR=./server/data/backups

# --- Bezpieczenstwo ---------------------------------------------------------
# WYMAGANE w produkcji: losowe ciagi o dlugosci min. 32 znakow.
# Wygeneruj poleceniem: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
# Liczba nieudanych prob logowania przed czasowa blokada konta.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_MINUTES=15

# --- Klient -----------------------------------------------------------------
# Lista dozwolonych adresow przegladarkowych (oddzielone przecinkiem).
CORS_ORIGINS=http://localhost:5173
# W produkcji serwer oddaje zbudowana aplikacje kliencka z katalogu client/dist.
SERVE_CLIENT=false
# CLIENT_DIST=./client/dist

# --- Zalaczniki -------------------------------------------------------------
MAX_UPLOAD_MB=15

# --- Kopie zapasowe ---------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=12
BACKUP_KEEP=30

# --- Dane poczatkowe (uzywane wylacznie przez npm run db:seed) --------------
# Hasła kont tworzonych przez `npm run db:seed` (tylko środowisko testowe).
SEED_ADMIN_PASSWORD=Admin#2026
SEED_DEMO_PASSWORD=Demo#2026

# Hasło początkowe konta `admin` zakładanego przy PIERWSZYM uruchomieniu
# zainstalowanego programu. Pozostaw puste - wtedy program wygeneruje hasło
# losowo i pokaże je w oknie, w pliku PIERWSZE-URUCHOMIENIE.txt oraz w dzienniku.
# Wartość ustawiaj wyłącznie przy instalacji masowej na wielu stanowiskach.
# ADMIN_INITIAL_PASSWORD=

# --- Klient (Vite, plik client/.env.local) ----------------------------------
# VITE_API_URL=http://localhost:4000/api
