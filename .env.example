# =====================================================================
# ResInvest ERP — plik konfiguracyjny środowiska
# Skopiuj do `.env` i uzupełnij wartości. Plik `.env` NIE trafia do repo.
# =====================================================================

# --- Serwer HTTP ---
# Port nasłuchu aplikacji.
PORT=4173
# Adres nasłuchu. 127.0.0.1 = tylko ten komputer, 0.0.0.0 = cała sieć firmowa.
HOST=127.0.0.1
# development | production — w production wyłączone są szczegóły błędów.
NODE_ENV=production

# --- Bezpieczeństwo ---
# Klucz podpisu tokenów JWT. WYMAGANY w production, minimum 32 znaki.
# Wygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Czas życia tokenu dostępu (minuty) i tokenu odświeżania (dni).
AUTH_ACCESS_TTL_MIN=30
AUTH_REFRESH_TTL_DAYS=14
# Maksymalna liczba nieudanych logowań zanim konto zostanie czasowo zablokowane.
AUTH_MAX_FAILED=8
AUTH_LOCK_MINUTES=15
# Lista dozwolonych źródeł CORS (rozdzielona przecinkami). Puste = tylko ten sam origin.
CORS_ORIGINS=

# --- Baza danych ---
# Ścieżka do pliku bazy SQLite (względna do katalogu projektu lub bezwzględna).
DB_FILE=./data/resinvest.db
# Automatyczne uruchomienie migracji przy starcie aplikacji.
DB_AUTO_MIGRATE=true

# --- Załączniki (skany PZ/WZ, kwity wywozowe) ---
ATTACHMENTS_DIR=./data/attachments
# Maksymalny rozmiar pojedynczego załącznika w megabajtach.
ATTACHMENTS_MAX_MB=12

# --- Kopie zapasowe ---
BACKUP_DIR=./data/backups
# Ile ostatnich kopii przechowywać (starsze są usuwane).
BACKUP_KEEP=30

# --- Konto administratora zakładane przy pierwszym starcie ---
# Jeżeli w bazie nie ma żadnego użytkownika, system utworzy to konto.
BOOTSTRAP_ADMIN_EMAIL=admin@resinvest.local
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator Systemu

# --- Dane firmy (nagłówki dokumentów i raportów) ---
COMPANY_NAME=ResInvest Commodities PL
COMPANY_ADDRESS=ul. Gwarecka 16, 41-800 Zabrze
COMPANY_NIP=
COMPANY_DEFAULT_WAREHOUSE=Magazyn RiC Zabrze

# --- Dziennik zdarzeń ---
# debug | info | warn | error
LOG_LEVEL=info
LOG_FILE=./data/logs/app.log
